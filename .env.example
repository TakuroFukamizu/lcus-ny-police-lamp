# Set the port shown by: python -m serial.tools.list_ports -v
# macOS: /dev/cu.usbserial-10
# Windows: COM3
# Linux: /dev/ttyUSB0 or /dev/serial/by-id/...
SERIAL_PORT=
# HTTP bind address: 127.0.0.1 = this PC only; 0.0.0.0 = all IPv4 interfaces
# For LAN access, clients use this PC's LAN IP. The API has no authentication.
HOST=127.0.0.1
# HTTP TCP port (1-65535); change if already in use
PORT=8000
